@model Amphenol.RMA.ViewModels.RmaLineViewModel
@{
    var index = ViewData["Index"]?.ToString() ?? "__INDEX__";
}
<tr>
    <td>
        <span class="btn btn-sm btn-outline-danger btn-remove-rma-line" title="Remove Line"><i class="fa fa-trash"></i></span>
    </td>
    <td>
        <div class="input-group">
            <input class="form-control" type="text" readonly asp-for="InvoiceNumber" />
            <span class="btn btn-sm btn-outline-secondary btn-search-invoice"><i class="fa fa-search"></i></span>
        </div>
    </td>
    <td>
        <div class="input-group">
            <input class="form-control" type="text" readonly asp-for="SequenceNumber" />
            <span class="btn btn-sm btn-outline-secondary"><i class="fa fa-search"></i></span>
        </div>
    </td>
    <td>
        <div class="input-group">
            <input class="form-control" type="text" readonly asp-for="PartNumber" />
            <span class="btn btn-sm btn-outline-secondary"><i class="fa fa-search"></i></span>
        </div>
    </td>
    <td>
        <select class="form-control" asp-for="SelectedAction"
                asp-items="@(new SelectList(Model.Actions, nameof(SelectableStringOption.SelectedValue), nameof(SelectableStringOption.DisplayValue)))">
        </select>
    </td>
    <td>
        <select class="form-control" asp-for="SelectedLocation"
                asp-items="@(new SelectList(Model.Locations, nameof(SelectableStringOption.SelectedValue), nameof(SelectableStringOption.DisplayValue)))">
        </select>
    </td>
    <td>
        <input class="form-control" type="text" asp-for="AuthorizedQuantity" />
    </td>
    <td>
        <input class="form-control" type="text" asp-for="Price" />
    </td>
    <td>
        <input class="form-control" type="text" asp-for="UnitCost" />
    </td>
    <td>
        <div class="input-group">
            <input class="form-control" type="text" readonly asp-for="ReturnCode" />
            <span class="btn btn-sm btn-outline-secondary"><i class="fa fa-search"></i></span>
        </div>
    </td>
    <td>
        <input class='w-100 text-center mt-2 mr-0 text-center' type='checkbox' asp-for="GenerateCAR" />
    </td>
</tr>
