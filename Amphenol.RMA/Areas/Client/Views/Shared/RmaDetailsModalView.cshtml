@model Amphenol.RMA.ViewModels.RmaViewModel
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using Amphenol.RMA.Models.Enumerations

@{
    <style>
        .comments-toggle .icon-collapsed {
            display: none;
        }

        .comments-toggle .icon-expanded {
            display: inline-block;
        }

        .comments-toggle.collapsed .icon-collapsed {
            display: inline-block;
        }

        .comments-toggle.collapsed .icon-expanded {
            display: none;
        }
    </style>
    var modalTitle = "RMA Request";

    var submitBadgeClass = Model.SubmitStatus.ToDisplayString() == "Not Submitted"
        ? "badge-secondary"
        : "badge-success";

    var statusBadgeClass = Model.RequestStatus.ToDisplayString() switch
    {
        "Approved" => "badge-success",
        "Rejected" => "badge-danger",
        "Pending" => "badge-warning",
        _ => "badge-info"
    };
}

<div class="modal-header">

    <h5 class="modal-title" id="exampleModalLongTitle">
        @modalTitle
    </h5>

    <div class="d-flex">
        @* <button type="button" class="btn btn-primary btn-sm mr-2" id="btnsubmitrma"><i class="fa fa-arrow-right"></i> Submit</button> *@
        <button type="button" data-bs-dismiss="modal" class="btn btn-sm btn-danger btn-dismiss-modal float-right m-0"><i class="fa fa-times"></i> </button>
    </div>
</div>
<div class="modal-body">

    <div class="row">
        <div class="d-flex align-items-center mb-3">
            <span class="font-weight-bold mr-2">Status:</span>

            <span class="badge @submitBadgeClass mr-2">
                @Model.SubmitStatus.ToDisplayString()
            </span>

            <span class="badge @statusBadgeClass">
                @Model.RequestStatus.ToDisplayString()
            </span>
        </div>
        @if (!string.IsNullOrEmpty(Model.Comments))
        {
            <div class="alert alert-secondary" role="alert">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="alert-heading mb-0 font-weight-bold">Comments</h5>
                    <button class="btn btn-sm btn-outline-secondary comments-toggle"
                            type="button"
                            data-toggle="collapse"
                            data-target="#commentsCollapse"
                            aria-expanded="true"
                            aria-controls="commentsCollapse">
                        <!-- Shown when expanded -->
                        <i class="fa fa-chevron-up icon-expanded"></i>
                        <!-- Shown when collapsed -->
                        <i class="fa fa-chevron-down icon-collapsed"></i>
                    </button>
                </div>
                <div class="collapse show mt-2" id="commentsCollapse">
                    <div style="white-space: pre-line;">@Model.Comments</div>
                </div>
            </div>
        }
        <div class="row">
            <!-- Request Information -->
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-4">Request #:</dt>
                    <dd class="col-8">@Model.RequestId</dd>

                    <dt class="col-4">Build Location:</dt>
                    <dd class="col-8">@Model.SelectedBuildLocation</dd>

                    <dt class="col-4">Request Type:</dt>
                    <dd class="col-8">@Model.SelectedRequestType</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-4">Date:</dt>
                    <dd class="col-8">@Model.Date</dd>

                    <dt class="col-4">Total Value:</dt>
                    <dd class="col-8">
                        $@Model.TotalValue.ToString("F4")
                    </dd>

                    <dt class="col-4">Reason:</dt>
                    <dd class="col-8">@Model.SelectedReason</dd>
                </dl>
            </div>
            <div class="col-12 mb-4">
                <div class="fw-bold mb-1">Description</div>
                <div class="border rounded p-3 bg-light">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "--" : Model.Description.Trim())
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <!-- Customer Information -->
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-4">Customer:</dt>
                    <dd class="col-8">
                        @(string.IsNullOrWhiteSpace(Model.CustomerId) ? "--" : Model.CustomerId)
                    </dd>
                    <dt class="col-4">Contact:</dt>
                    <dd class="col-8">
                        @(string.IsNullOrWhiteSpace(Model.Contact) ? "--" : Model.Contact)
                    </dd>
                    <dt class="col-4">Phone:</dt>
                    <dd class="col-8">
                        @(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "--" : Model.PhoneNumber)
                        @if (!string.IsNullOrWhiteSpace(Model.ExtensionNumber))
                        {
                            <span class="ms-3">  <strong>Ext:</strong> @Model.ExtensionNumber</span>
                        }
                    </dd>

                    <dt class="col-4">Email:</dt>
                    <dd class="col-8">
                        @(string.IsNullOrWhiteSpace(Model.ContactEmail) ? "--" : Model.ContactEmail)
                    </dd>
                </dl>
            </div>

            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-4">Cust. PO #:</dt>
                    <dd class="col-8">
                        @(string.IsNullOrWhiteSpace(Model.PoNumber) ? "--" : Model.PoNumber)
                    </dd>
                    <dt class="col-4">Ship To:</dt>
                    <dd class="col-8">
                        @(string.IsNullOrWhiteSpace(Model.ShipTo) ? "--" : Model.ShipTo)
                    </dd>

                    <dt class="col-4">Fax:</dt>
                    <dd class="col-8">
                        @(string.IsNullOrWhiteSpace(Model.Fax) ? "--" : Model.Fax)
                    </dd>
                    <dt class="col-4">Co. Email:</dt>
                    <dd class="col-8">
                        @(string.IsNullOrWhiteSpace(Model.CompanyEmail) ? "--" : Model.CompanyEmail)
                    </dd>
                </dl>
            </div>
        </div>
        <hr />
        <div class="row mb-3">
            <div class="col-12 mb-4">
                <div class="fw-bold mb-1">Complaint</div>
                <div class="border rounded p-3 bg-light">
                    @(string.IsNullOrWhiteSpace(Model.Complaint) ? "--" : Model.Complaint.Trim())
                </div>
            </div>
        </div>
        <div class="row mb-3">
            <dl class="row">
                <dt class="col-4">Lines</dt>
            </dl>
            <div class="table-responsive">
                <table id="GeneratedRmaTable" class="table table-striped table-bordered text-center align-middle over">
                    <thead class="table-light">
                        <tr>
                            <th>Invoice #</th>
                            <th>Sequence #</th>
                            <th>Part Number</th>
                            <th>Action</th>
                            <th>Loc</th>
                            <th>Authorized Qty</th>
                            <th>Price</th>
                            <th>Unit Cost</th>
                            <th>Return Code</th>
                            <th>CAR Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td>
                                    @line.InvoiceNumber
                                </td>
                                <td>
                                    @line.SequenceNumber
                                </td>
                                <td>
                                    @line.PartNumber
                                </td>
                                <td>
                                    @line.SelectedAction
                                </td>
                                <td>
                                    @line.SelectedLocation
                                </td>
                                <td>
                                    @line.AuthorizedQuantity
                                </td>
                                <td>
                                    @line.Price.ToString("F4")
                                </td>
                                <td>
                                    @line.UnitCost.ToString("F4")
                                </td>
                                <td>
                                    @line.ReturnCode
                                </td>
                                <td>
                                    @if (@line.GenerateCAR)
                                    {
                                        <i class="fas fa-file-alt text-success" data-bs-toggle="tooltip" data-bs-placement="right" title="CAR Generated"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-file-alt text-muted" data-bs-toggle="tooltip" data-bs-placement="right" title="CAR Not Generated"></i>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
        <div class="row mb-3">
            <dl class="row">
                <dt class="col-4">Attachments</dt>
            </dl>

            @if (Model.Attachments != null && Model.Attachments.Any())
            {
                <div class="table-responsive">
                    <table id="GeneratedRmaTable" class="table table-striped table-bordered text-center align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Filename</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var file in Model.Attachments)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="DownloadAttachment" asp-route-id="@file.Id" target="_blank">
                                            @file.FileName
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-light">
                    No attachments available.
                </div>
            }
        </div>
