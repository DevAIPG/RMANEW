@model Amphenol.RMA.ViewModels.RmaModalViewModel
@using Microsoft.AspNetCore.Mvc.ViewFeatures

@{
    var isViewMode = string.Equals(Model.Mode, "View", StringComparison.OrdinalIgnoreCase);

    var modalTitle = isViewMode ? "RMA Request" : "Edit RMA Request";

    var submitBadgeClass = Model.Data.Details.Sumbit == "Not Submitted"
        ? "badge-secondary"
        : "badge-success";

    var statusBadgeClass = Model.Data.Details.Status switch
    {
        "Approved" => "badge-success",
        "Rejected" => "badge-danger",
        "Pending" => "badge-warning",
        _ => "badge-info"
    };
}

<div class="modal-header">

    <h5 class="modal-title" id="exampleModalLongTitle">
        @modalTitle
    </h5>

    <div class="d-flex">
        @* <button type="button" class="btn btn-primary btn-sm mr-2" id="btnsubmitrma"><i class="fa fa-arrow-right"></i> Submit</button> *@
        <button type="button" data-dismiss="modal" onclick="DismissRmaModal();" class="btn btn-sm btn-danger float-right m-0"><i class="fa fa-times"></i> </button>
    </div>
</div>
<div class="modal-body">
    <input type="hidden" name="name" value="" readonly id="rmaid" />
    <input type="hidden" name="name" value="" readonly id="rmastatus" />
    <input type="hidden" name="name" value="" readonly id="rmasubmit" />
    <input type="hidden" name="name" value="" readonly id="rma500" />
    @if (isViewMode)
    {
        <div class="row">
            <div class="d-flex align-items-center mb-3">
                <span class="font-weight-bold mr-2">Status:</span>

                <span class="badge @submitBadgeClass mr-2">
                    @Model.Data.Details.Sumbit
                </span>

                <span class="badge @statusBadgeClass">
                    @Model.Data.Details.Status
                </span>
            </div>
            <div class="row">
                <!-- Request Information -->
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-4">Request #:</dt>
                        <dd class="col-8">@Model.Data.Details.Rmarequest</dd>

                        <dt class="col-4">Build Location:</dt>
                        <dd class="col-8">@Model.Data.Details.Wherebuilt</dd>

                        <dt class="col-4">Request Type:</dt>
                        <dd class="col-8">@Model.Data.Details.Rmatypeofrequest</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-4">Date:</dt>
                        <dd class="col-8">@Model.Data.Details.Date</dd>

                        <dt class="col-4">Total Value:</dt>
                        <dd class="col-8">
                            $@Model.Data.Details.Totalrmavalues.ToString("F4")
                        </dd>

                        <dt class="col-4">Reason:</dt>
                        <dd class="col-8">@Model.Data.Details.reason</dd>
                    </dl>
                </div>
                <div class="col-12 mb-4">
                    <div class="fw-bold mb-1">Description</div>
                    <div class="border rounded p-3 bg-light">
                        @(string.IsNullOrWhiteSpace(Model.Data.Details.Description) ? "--" : Model.Data.Details.Description.Trim())
                    </div>
                </div>
            </div>
            <hr />
            <div class="row">
                <!-- Customer Information -->
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-4">Customer:</dt>
                        <dd class="col-8">
                            @(string.IsNullOrWhiteSpace(Model.Data.Details.Customer) ? "--" : Model.Data.Details.Customer)
                        </dd>
                        <dt class="col-4">Contact:</dt>
                        <dd class="col-8">
                            @(string.IsNullOrWhiteSpace(Model.Data.Details.Contact) ? "--" : Model.Data.Details.Contact)
                        </dd>
                        <dt class="col-4">Phone:</dt>
                        <dd class="col-8">
                            @(string.IsNullOrWhiteSpace(Model.Data.Details.Phone) ? "--" : Model.Data.Details.Phone)
                            @if (!string.IsNullOrWhiteSpace(Model.Data.Details.Ext))
                            {
                                <span class="ms-3">  <strong>Ext:</strong> @Model.Data.Details.Ext</span>
                            }
                    </dd>

                    <dt class="col-4">Email:</dt>
                    <dd class="col-8">
                        @(string.IsNullOrWhiteSpace(Model.Data.Details.Email) ? "--" : Model.Data.Details.Email)
                    </dd>
                </dl>
            </div>

            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-4">Cust. PO #:</dt>
                    <dd class="col-8">
                        @(string.IsNullOrWhiteSpace(Model.Data.Details.Customerpo) ? "--" : Model.Data.Details.Customerpo)
                    </dd>
                    <dt class="col-4">Ship To:</dt>
                    <dd class="col-8">
                        @(string.IsNullOrWhiteSpace(Model.Data.Details.Ship_To) ? "--" : Model.Data.Details.Ship_To)
                    </dd>

                    <dt class="col-4">Fax:</dt>
                    <dd class="col-8">
                        @(string.IsNullOrWhiteSpace(Model.Data.Details.Fax) ? "--" : Model.Data.Details.Fax)
                    </dd>
                    <dt class="col-4">Co. Email:</dt>
                    <dd class="col-8">
                        @(string.IsNullOrWhiteSpace(Model.Data.Details.Company) ? "--" : Model.Data.Details.Company)
                    </dd>
                </dl>
            </div>
        </div>
        <hr />
        <div class="row mb-3">
            <div class="col-12 mb-4">
                <div class="fw-bold mb-1">Complaint</div>
                <div class="border rounded p-3 bg-light">
                    @(string.IsNullOrWhiteSpace(Model.Data.Details.Customercomplait)
                                        ? "--"
                                        : Model.Data.Details.Customercomplait.Trim())
                                                                                 </div>
                                                                             </div>

            <div class="col-12">
                <div class="fw-bold mb-1">Comments</div>
                <div class="border rounded p-3 bg-light">
                    @(string.IsNullOrWhiteSpace(Model.Data.Details.Comment)
                                        ? "--"
                                        : Model.Data.Details.Comment.Trim())
                </div>
            </div>
        </div>

