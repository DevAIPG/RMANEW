                            </div>
                        </dd>
                        <dt class="col-4">Ship To:</dt>
                        <dd class="col-8">
                            <div class="input-group">
                                <input class="form-control" disabled asp-for="Data.Details.Ship_To" id="inputShipTo" />
                                <span class="btn btn-sm btn-outline-secondary" onclick="OpenShipToModal()" ><i class="fa fa-search"></i></span>
                            </div>
                        </dd>


                        <dt class="col-4 contact-info">Phone:</dt>
                        <dd class="col-8 contact-info">
                            <div class="row">
                                <div class="col-7">
                                    <input class="form-control" asp-for="Data.Details.Phone" id="inputPhone" />
                                </div>
                                <div class="col-2 text-end">
                                    <label for="inputExtension" class="col-form-label"><strong>Ext:</strong></label>
                                </div>
                                <div class="col-3">
                                    <input class="form-control" asp-for="Data.Details.Ext" id="inputExtension" />
                                </div>
                            </div>
                        </dd>

                        <dt class="col-4 contact-info">Email:</dt>
                        <dd class="col-8 contact-info">
                            <input class="form-control" asp-for="Data.Details.Email" id="inputContactEmail" />
                        </dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-4">Cust. PO #:</dt>
                        <dd class="col-8">
                            <input class="form-control" asp-for="Data.Details.Customerpo" id="inputCustomerPo" />
                        </dd>
                        <dt class="col-4  contact-info">Contact:</dt>
                        <dd class="col-8  contact-info">
                            <input class="form-control" asp-for="Data.Details.Contact" id="inputContact" />
                        </dd>

                        <dt class="col-4 contact-info">Fax:</dt>
                        <dd class="col-8 contact-info">
                            <input class="form-control" asp-for="Data.Details.Fax" id="inputFax" />
                        </dd>
                        <dt class="col-4 contact-info">Co. Email:</dt>
                        <dd class="col-8 contact-info">
                            <input class="form-control" asp-for="Data.Details.Company" id="inputCompanyEmail" />
                        </dd>
                    </dl>
                </div>
                <div class="col-12 mb-4">
                    <div class="fw-bold mb-1">Complaint</div>
                    <textarea class="form-control" asp-for="Data.Details.Customercomplait" id="textareaComplaint"></textarea>
                </div>
                <hr />
            </div>
            <!-- Line Information -->
            <div class="row">
                <div class="col-6">
                    <dl class="row">
                        <dt class="col-4">Lines</dt>
                    </dl>
                </div>
                <div class="col-6">
                    <span class="btn btn-sm btn-primary action-btn float-right btn-add-rma-line"><i class="fa fa-plus"></i></span>
                </div>
                <div class="col-12 mb-3">
                    <div class="table-responsive">
                        <table id="LineTable" class="table table-striped table-bordered text-center align-middle" style="table-layout:fixed;">
                            <thead class="table-light">
                                <tr>
                                    <th width="35px"></th>
                                    <th width="150px">Invoice #</th>
                                    <th width="90px">Sequence</th>
                                    <th width="150px">Part Number</th>
                                    <th width="80px">Action</th>
                                    <th width="150px">Location</th>
                                    <th width="150px">Authorized Qty</th>
                                    <th width="150px">Price</th>
                                    <th width="150px">Unit Cost</th>
                                    <th width="150px">Return Code</th>
                                    <th width="120px">Create CAR</th>
                                </tr>
                            </thead>
                            <tbody>

                                @for (int i = 0; i < Model.Data.ItemLines.Count; i++)
                                {
                                    @await Html.PartialAsync("RmaItemEditableLine", Model.Data.ItemLines[i], new ViewDataDictionary(ViewData) { ["Index"] = i })
                                }
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
            <!-- Attachment Information -->
            <div class="row">
                <div class="col-6">
                    <dl class="row">
                        <dt class="col-4">Attachments</dt>
                    </dl>
                </div>
                <div class="col-6">
                    <span class="btn btn-sm btn-primary action-btn float-right"><i class="fa fa-plus"></i></span>
                </div>
                <div class="col-12">
                    @if (Model.Data.Attachments.Any())
                    {
                        <div class="table-responsive">
                            <table id="GeneratedRmaTable" class="table table-striped table-bordered text-center align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th class="d-none">ID</th>
                                        <th></th>
                                        <th>Filename</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var file in Model.Data.Attachments)
                                    {
                                        <tr>
                                            <td class="d-none">@file.Id</td>
                                            <td>
                                                <span class="btn btn-sm btn-outline-danger" title="Remove Attachment"><i class="fa fa-trash"></i></span>
                                            </td>
                                            <td>@file.Documento</td>
                                            <td>
                                                <span class="btn btn-light btn-sm action-btn"
                                                      data-bs-toggle="tooltip"
                                                      title="View File">
                                                    <i class="fa fa-eye"></i>
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light">
                            No attachments available.
                        </div>
                    }

                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button class="btn btn-primary">Save Changes</button>
        </div>
        @* </form> *@
    }
</div>
