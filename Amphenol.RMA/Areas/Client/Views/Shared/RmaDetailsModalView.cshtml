            <div class="row mb-3">
                <dl class="row">
                    <dt class="col-4">Lines</dt>
                </dl>
                <div class="table-responsive">
                    <table id="GeneratedRmaTable" class="table table-striped table-bordered text-center align-middle over">
                        <thead class="table-light">
                            <tr>
                                <th>Invoice #</th>
                                <th>Sequence #</th>
                                <th>Part Number</th>
                                <th>Action</th>
                                <th>Loc</th>
                                <th>Authorized Qty</th>
                                <th>Price</th>
                                <th>Unit Cost</th>
                                <th>Return Code</th>
                                <th>CAR Created</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var line in Model.Data.ItemLines)
                            {
                                <tr>
                                    <td>
                                        @line.Invoice
                                    </td>
                                    <td>
                                        @line.Seq
                                    </td>
                                    <td>
                                        @line.Coustumer
                                    </td>
                                    <td>
                                        @line.Action
                                    </td>
                                    <td>
                                        @line.Loc
                                    </td>
                                    <td>
                                        @line.Qty
                                    </td>
                                    <td>
                                        @line.Unit.ToString("F4")
                                    </td>
                                    <td>
                                        @line.Cost.ToString("F4")
                                    </td>
                                    <td>
                                        @line.Retur
                                    </td>
                                    <td>
                                        @if (@line.Car)
                                        {
                                            <i class="fas fa-file-alt text-success" title="CAR Generated"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-file-alt text-muted" title="CAR Not Generated"></i>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
            <div class="row mb-3">
                <dl class="row">
                    <dt class="col-4">Attachments</dt>
                </dl>

                @if (Model.Data.Attachments != null && Model.Data.Attachments.Any())
                {
                    <div class="table-responsive">
                        <table id="GeneratedRmaTable" class="table table-striped table-bordered text-center align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th class="d-none">ID</th>
                                    <th>Filename</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var file in Model.Data.Attachments)
                                {
                                    <tr>
                                        <td class="d-none">@file.Id</td>
                                        <td>@file.Documento</td>
                                        <td>
                                            <span class="btn btn-light btn-sm action-btn"
                                                  data-bs-toggle="tooltip"
                                                  title="View File">
                                                <i class="fa fa-eye"></i>
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-light">
                        No attachments available.
                    </div>
                }
            </div>
