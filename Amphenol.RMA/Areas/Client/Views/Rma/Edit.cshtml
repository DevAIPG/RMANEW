@model Amphenol.RMA.ViewModels.RmaViewModel
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout6.cshtml";
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    var errorTitle = TempData["ErrorTitle"] as string ?? "Something went wrong";

    <div class="d-flex justify-content-center align-items-center py-5">
        <div class="card shadow-sm border-0 text-center" style="max-width: 500px; width: 100%;">
            <div class="card-body p-5">
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light"
                         style="width: 64px; height: 64px;">
                        <i class="fas fa-exclamation-triangle text-danger fa-2x"
                           aria-hidden="true"></i>
                    </div>
                </div>
                <h4 class="card-title font-weight-bold mb-3">
                    @errorTitle
                </h4>
                <p class="card-text text-muted mb-4">
                    @errorMessage
                </p>
                <a href="@Model.ReturnUrl" class="btn btn-primary px-4">
                    <i class="fas fa-arrow-left mr-2" aria-hidden="true"></i>
                    Back To @Model.ReturnPageTitle
                </a>
            </div>
        </div>
    </div>
}
else
{
    <link href="~/css/jquery.loadingModal.min.css" rel="stylesheet" />
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <div class="card">
        <form id="editRmaForm" asp-action="Edit" asp-controller="Rma" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(x => x.RequestStatus)
            @Html.HiddenFor(x => x.RequestId)
            @Html.HiddenFor(x => x.ReturnUrl)
            <div class="card-header m-3 bg-white">
                <div class="card-title">
                    <div class="col-12">
                        <h5 class="font-weight-bold">Edit RMA Request</h5>

                        <small class="text-muted">

                            <span class="text-danger">*</span> Required fields

                        </small>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <!-- Request Information -->
                <div class="row m-3">
                    <div class="col-12 mb-3">
                        <h5 class="font-weight-bold">1- RMA Information</h5>
                    </div>
                    <div class="col-6">
                        <div class="mb-2 row">
                            <label class="col-4 col-form-label font-weight-bold">Request Number:</label>
                            <label class="col-8 form-control disabled" style="background-color:#e9ecef">@Model.RequestId</label>
                        </div>
                        <div class="mb-2 row">
                            <label class="col-4 col-form-label font-weight-bold">Build Location<span class="ml-2 text-danger">*</span></label>
                            <select class="col-8 form-select form-control" asp-for="SelectedBuildLocation" id="selectWherebuilt"
                                    asp-items="@(new SelectList(Model.BuildLocations))">
                            </select>
                        </div>
                        <div class="mb-2 row">
                            <label class="col-4 col-form-label font-weight-bold">Request Type <span class="ml-2 text-danger">*</span></label>
                            <select class="col-8 form-select form-control" asp-for="SelectedRequestType" id="selectRequestType"
                                    asp-items="@(new SelectList(Model.RequestTypes))">
                            </select>
                        </div>
                        <div class="mb-2 row">
                            <div class="col-4 col-form-label font-weight-bold">Customer Complaint<span class="ml-2 text-danger">*</span></div>
                            <textarea class="col-8 form-control  complaint-textarea" rows="4" asp-for="Complaint" id="textareaComplaint"></textarea>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="mb-2 row">
                            <label class="col-4 col-form-label font-weight-bold">Date:</label>
                            <label class="col-8 form-control disabled" style="background-color:#e9ecef">@Model.Date.ToString("MM/dd/yyyy")</label>
                        </div>
                        <div class="mb-2 row">
                            <label class="col-4 col-form-label font-weight-bold">RMA Reason<span class="ml-2 text-danger">*</span></label>
                            <select class="col-8 form-select form-control" asp-for="SelectedReason" id="selectReason"
                                    asp-items="@(new SelectList(Model.Reasons))">
                            </select>
                        </div>
                        <div class="mb-2 row">
                            <div class="col-4 col-form-label font-weight-bold">Issue Description:</div>
                            <input class="col-8 form-control" asp-for="Description" id="inputDescription" maxlength="29" />
                        </div>
                    </div>
                    <div class="border-top mt-4 pt-4">
                    </div>
                </div>
                <!-- Customer Information -->
                <div class="row m-3">
                    <div class="col-12 mb-3">
                        <h5 class="font-weight-bold">2- Customer Information</h5>
                    </div>
                    <div class="col-6">
                        <div class="mb-2 row">
                            <label class="col-4 col-form-label font-weight-bold" for="inputCustomer">Customer Number<span class="ml-2 text-danger">*</span></label>
                            <div class="col-8 input-group">
                                <input tabindex="1" class="form-control  customer-input" placeholder="Enter or search for a customer id" asp-for="CustomerId" id="inputCustomer" list="customerOptions" autocomplete="off" />
                                <span class="btn btn-sm btn-outline-secondary" data-toggle="modal" data-target="#CustomerModal"><i class="fa fa-search"></i></span>
                            </div>
                            <datalist id="customerOptions">
                            </datalist>
                            <div class="invalid-feedback">
                                Please provide a customer number.
                            </div>
                        </div>
                        <div class="mb-2 row customer-info d-none">
                            <label class="col-4 col-form-label font-weight-bold">Contact<span class="ml-2 text-danger">*</span></label>
                            <div class="col-8 input-group">
                                <input class="form-control  contact-input" asp-for="Contact" id="inputContact" />
                                <span asp-validation-for="Contact" class="col-12 text-danger"></span>
                            </div>

                        </div>
                        <div class="mb-2 row customer-info d-none">
                            <label class="col-4 col-form-label font-weight-bold">
                                Phone<span class="ml-2 text-danger">*</span>
                            </label>
                            <div class="col-8">
                                <div class="row">
                                    <div class="col-6">
                                        <input class="form-control  phone-input" type="tel" asp-for="PhoneNumber" id="inputPhone" />
                                    </div>
                                    <label class="col-2 col-form-label font-weight-bold">
                                        Ext:
                                    </label>
                                    <div class="col-4">
                                        <input class="form-control" asp-for="ExtensionNumber" type="tel" id="inputExtension" />
                                    </div>
                                    <span asp-validation-for="PhoneNumber" class="col-12 text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="mb-2 row customer-info d-none">
                            <label class="col-4 col-form-label font-weight-bold">Email<span class="ml-2 text-danger">*</span></label>
                            <div class="col-8 input-group">
                                <input class="form-control  contactEmail-input" asp-for="ContactEmail" id="inputContactEmail" />
                                <span asp-validation-for="ContactEmail" class="col-12 text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="mb-2 row shipto-section d-none">
                            <label class="col-4 col-form-label font-weight-bold">Ship To<span class="ml-2 text-danger">*</span></label>
                            <div class="col-8 input-group">
                                <input tabindex="2" class="form-control  shipto-input disabled" readonly asp-for="ShipTo" id="inputShipTo" autocomplete="off" />
                                <span class="btn btn-sm btn-outline-secondary" onclick="OpenShipToModal()"><i class="fa fa-search"></i></span>
                                <span asp-validation-for="ShipTo" class="col-12 text-danger"></span>
                            </div>
                        </div>
                        <div class="mb-2 row customer-info d-none">
                            <label class="col-4 col-form-label font-weight-bold">PO Number<span class="ml-2 text-danger">*</span></label>
                            <div class="col-8 input-group">
                                <input class="form-control  po-input" asp-for="PoNumber" id="inputCustomerPo" />
                                <span asp-validation-for="PoNumber" class="col-12 text-danger"></span>
                            </div>

                        </div>
                        <div class="mb-2 row customer-info d-none">
                            <label class="col-4 col-form-label font-weight-bold">Fax:</label>
                            <div class="col-8 input-group">
                                <input class="form-control" asp-for="Fax" id="inputFax" />
                            </div>
                        </div>
                        <div class="mb-2 row customer-info d-none">
                            <label class="col-4 col-form-label font-weight-bold">Company Email:</label>
                            <div class="col-8 input-group">
                                <input class="form-control disabled" readonly asp-for="CompanyEmail" id="inputCompanyEmail" />
                            </div>
                        </div>
                    </div>
                    <div class="border-top mt-4 pt-4">
                    </div>
                </div>
                <!-- Line Information -->
                <div class="row line-section m-3 d-none">
                    <div class="col-12 mb-3">
                        <h5 class="font-weight-bold mr-3">3- Lines</h5>
                        <span class="btn btn-sm btn-primary action-btn float-right btn-add-rma-line"><i class="fa fa-plus"></i></span>
                    </div>

                    <div class="col-12 mb-2">
                        <div class="table-responsive">
                            <table id="LineTable" class="table table-striped table-bordered text-center align-middle" style="table-layout:fixed;">
                                <colgroup>
                                    <col style="width:50px">
                                    <col style="width:150px">
                                    <col style="width:100px">
                                    <col style="width:260px">
                                    <col style="width:260px">
                                    <col style="width:215px">
                                    <col style="width:150px">
                                    <col style="width:150px">
                                    <col style="width:150px">
                                    <col style="width:150px">
                                    <col style="width:120px">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Invoice #</th>
                                        <th>Sequence</th>
                                        <th>Part Number</th>
                                        <th>Action</th>
                                        <th>Location</th>
                                        <th>Authorized Qty</th>
                                        <th>Price</th>
                                        <th>Unit Cost</th>
                                        <th>Return Code</th>
                                        <th>Create CAR</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Lines != null && Model.Lines.Any())
                                    {
                                        @for (int i = 0; i < Model.Lines.Count; i++)
                                        {
                                            @await Html.PartialAsync("RmaItemEditableLine", Model.Lines[i], new ViewDataDictionary(ViewData) { ["Index"] = i })
                                        }
                                    }
                                    else
                                    {
                                        <tr id="emptyLineRow">
                                            <td colspan="11" class="text-center text-muted py-4">
                                                <div class="d-flex justify-content-center align-items-center">
                                                    <h5 class="font-weight-bold mb-0 mr-3">Add new lines</h5>
                                                    <button type="button" class="btn btn-sm btn-primary action-btn btn-add-rma-line">
                                                        <i class="fa fa-plus"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-12 mt-3">
                        <div class="alert alert-light border mb-0 text-right">
                            <strong>Total RMA Value:</strong>
                            $<span class="totalrmavalue-label">@Model.TotalValue</span>
                        </div>
                    </div>
                    <div class="col-12 mt-3 mb-3">
                        <hr>
                    </div>
                </div>
                <!-- Attachment Information -->
                <div class="row attachment-section m-3 d-none">
                    <div class="col-12 mb-3">
                        <h5 class="font-weight-bold">4- Attachments</h5>
                        <span class="btn btn-sm btn-primary action-btn float-right btn-add-rma-attachment"><i class="fa fa-plus"></i></span>
                    </div>
                    <div class="col-12">
                        <input type="file" id="attachmentInput" name="UploadedFiles" multiple hidden />
                        <div class="table-responsive">
                            <table id="AttachmentTable" class="table table-striped table-bordered text-center align-middle" style="table-layout:fixed;">
                                <colgroup>
                                    <col style="width:50px">
                                    <col>
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Filename</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Attachments != null && Model.Attachments.Any())
                                    {
                                        @for (int i = 0; i < Model.Attachments.Count; i++)
                                        {
                                            @await Html.PartialAsync("RmaAttachmentRow", Model.Attachments[i], new ViewDataDictionary(ViewData) { ["Index"] = i })
                                        }
                                    }
                                    else
                                    {
                                        <tr id="emptyAttachmentRow">
                                            <td colspan="2" class="text-center text-muted py-4">
                                                <div class="d-flex justify-content-center align-items-center">
                                                    <h5 class="font-weight-bold mb-0 mr-3">Add attachments</h5>
                                                    <button type="button" class="btn btn-sm btn-primary action-btn btn-add-rma-attachment">
                                                        <i class="fa fa-plus"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer m-3 bg-white text-right">
                <a class="btn btn-secondary mr-5" href="@Model.ReturnUrl">
                    Cancel
                </a>

                <button type="submit" name="submitAction" value="save" class="btn btn-outline-primary mr-3">
                    Save Changes
                </button>

                @if (Model.CanResubmit)
                {
                    <button type="submit" name="submitAction" value="resubmit" class="btn btn-primary">
                        Re-Submit RMA
                    </button>
                }
                @if (Model.CanSubmit)
                {
                    <button type="submit" name="submitAction" value="submit" class="btn btn-primary">
                        Submit RMA
                    </button>
                }
            </div>
        </form>
    </div>
    <partial name="_RmaRequestModals" />
}
@section Scripts {
    <script src="~/js/jquery.loadingModal.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.3/dist/sweetalert2.all.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.3/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="~/js/RmaRequest.js"></script>
}
