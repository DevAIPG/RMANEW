        function CreateorderyesbtnF(id) {
            // let id = $("#createorderyesbtn").data("id");

            $('#tblQm').modal('hide');

            // First AJAX call: Fetch data using the ID
            $.ajax({
                url: '/Client/rma/RMA_IdTo_OrderCreate',
                type: 'GET',
                data: { id: id },
                success: function (response) {
                    console.log('Success:', response);

                    var data = {
                        rmaNo: response.rmaNo,
                        orderDate: response.orderDate,
                        //previewOnly: response.previewOnly
                    };

                    // Second AJAX call: Create the order
                    $.ajax({
                        url: '/Client/rma/CreateOrderpost',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(data),
                        success: function (response) {
                            console.log('Order creation success:', response);

                            $('#NewOrderModal .modal-title').text("Order Created");
                            $('#NewOrderModal .modal-body').html(response.message);
                            $('#NewOrderModal').modal('show');


                            // alert('Order created: ' + response.message); // ✅ lowercase "message"
                        },
                        error: function (err) {
                            console.error('Order creation error:', err);
                            $('#NewOrderModal .modal-title').text("Order Creation Failed");

                            // If server sends JSON with message:
                            if (err.responseJSON && err.responseJSON.message) {
                            $('#NewOrderModal .modal-body').html(err.responseJSON.message);

                                // alert('Error: ' + err.responseJSON.message);
                            } else {
                               $('#NewOrderModal .modal-body').html('An unexpected error occurred.');

                                // alert('An unexpected error occurred.');
                            }
                              $('#NewOrderModal').modal('show');
                        }
                    });
                },
                error: function (xhr) {
                    var err = xhr.responseJSON?.Error;
                    console.error('Error fetching RMA data:', err);
                    alert('Error: ' + err);
                }
            });
        }



        function Abrir(data) {
            var now = new Date();
            var datetime = now.getFullYear() + '/' + (now.getMonth() + 1) + '/' + now.getDate();
            datetime += ' ' + now.getHours() +

                ':' + now.getMinutes() + ':' + now.getSeconds();


            $.ajax({
                url: "/Client/rma/GetDetalles/?id=" + data + "&fecha=" + datetime,
                type: "GET",
                datatype: "json",
                cache: true,

                success: function (data) {
                    var dd = data.data[0].id;
                    $("#dd").val(dd);
                    var aa = data.data[0].rmarequest;
                    $("#aa").val(aa);
                    var b = data.data[0].date;
                    $("#b").val(b);
                    var c = data.data[0].customer;
                    $("#c").val(c);
                    var d = data.data[0].customerpartno;
                    $("#d").val(d);
                    var e = data.data[0].customerpo;
                    $("#e").val(e);
                    var f = data.data[0].description;
                    $("#f").val(f);
                    var g = data.data[0].customercomplait;
                    $("#g").val(g);
                    var h = data.data[0].rmatypeofrequest;

                    $("#h option[value='" + h + "']").attr("selected", true);

                    var i = data.data[0].totalrmavalues;
                    $("#i").val(i);
                    var j = data.data[0].rmA500;
                    $("#j option[value='" + j + "']").attr("selected", true);

                    var k = data.data[0].wherebuilt;
                    $("#k option[value='" + k + "']").attr("selected", true);

                    console.log(data);

                },
                error: function (xhr, status, error) { $().toastmessage('showToast', { text: 'Error con ean ' + xhr.responseText, sticky: true, type: 'error' }); }
            });

        }

        function Document(data) {
            var now = new Date();
            var datetime = now.getFullYear() + '/' + (now.getMonth() + 1) + '/' + now.getDate();
            datetime += ' ' + now.getHours() +

                ':' + now.getMinutes() + ':' + now.getSeconds();


            $.ajax({
                url: "/Client/rma/GetDocument/?id=" + data + "&fecha=" + datetime,
                type: "GET",
                datatype: "json",
                cache: true,

                success: function (data) {
                    var pdf = "";
                    console.log(data);
                    $("#tblStandar").children("tbody").empty();

                    for (i = 0; i < data.data.length; i++) {
                        pdf = data.data[i].documento;
                        id = data.data[i].id;
                        $("#tblStandar").children("tbody").append('<tr>' +
                            '<td align="center" style="dislay: none;">' + data.data[i].documento + '</td>' +
                            '<td align="center" style="dislay: none;"> <a href=javascript:finestraSecundaria("../../../documents/documents/rma/' + pdf.replace(/\s/g, "¶") + '")><img src="../../../documento.png" ></a></td>' +
                            '<td align="center" style="dislay: none;"><a onclick=Deletedocument("/Client/rma/Deletedocument/' + id + '") class="btn btn-danger text-white" style="cursor: pointer; width: 100px;"> <i class="fas fa-trash-alt"></i> Delete </a></td> </tr> ');
                    }
                },
                error: function (xhr, status, error) { $().toastmessage('showToast', { text: 'Error con ean ' + xhr.responseText, sticky: true, type: 'error' }); }
            });


        }


