@model Amphenol.RMA.Models.CSEXSW_Rma
@{
    ViewData["Title"] = "Approval Control";
    Layout = "~/Views/Shared/_Layout6.cshtml";
}
<style>
    .estilotextarea {
        height: 600px !important;
    }

    input[type=checkbox] {
        /* Double-sized Checkboxes */
        -ms-transform: scale(2); /* IE */
        -moz-transform: scale(2); /* FF */
        -webkit-transform: scale(2); /* Safari and Chrome */
        -o-transform: scale(2); /* Opera */
        transform: scale(2);
        padding: 10px;
    }

    .action-btn {
        width: 32px;
        height: 32px;
        padding: 0;
    }
</style>
@* <div class="espera">
    <div class="gif"><img src="~/tenor.gif" alt=""></div>
    <input type="hidden" id="proceso" value="control" />
</div>
<br /> *@
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-6">
                <h2 class="text-primary">Approval Control</h2>
            </div>

        </div>
        <input type="hidden" id="proceso" value="control" />
        <br />
        <div class="cargar">
            <table id="tblCar" class="table table-striped table-bordered text-center align-middle">
                <thead>
                    <tr>
                        <th>Actions</th>
                        <th>Approval</th>
                        <th>Request #</th>
                        <th>Date</th>
                        <th>Prepared</th>
                        <th>Customer Part #</th>
                        <th>Description</th>
                        <th>Request Type</th>
                        <th>Total Value</th>
                        <th>Built At</th>
                        <th>Approver</th>
                        <th>Customer PO #</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>


<!--part numbers-->
<div id="mPN" class="modal fade bd-example-modal-lg my-controller" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title lol" id="exampleModalLabel">Part numbers</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group row">
                    <table id="tblPN" class="table table-striped table-bordered w-100" style="width:100%;">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>ITEM NO</th>
                                <th>ITEM DESCRIPTION</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                    <div id="paginationPN"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="$('#tblQm').modal('hide');" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!--sequences-->
<div class="modal fade" id="mseq" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content ">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Invoice No</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-sm table-striped w-100" id="tblseq">
                        <thead>
                            <tr>
                                <th>Seq No</th>
                                <th>Orden type</th>
                                <th>Orden No</th>
                                <th>Item No</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="$('#tblQm').modal('hide');" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- invoices -->
<div class="modal fade" id="minvoices" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content ">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Invoice No</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-sm table-striped w-100" id="tblinvoices">
                        <thead>
                            <tr>
                                <th>Invoice #</th>
                                <th>Order #</th>
                                <th>Customer #</th>
                                <th>Order Type</th>
                                <th>ord_dt</th>
                                <th>cusAltAdrCd</th>
                                <th>currTrxRt</th>
                                <th>currCd</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="$('#tblQm').modal('hide');" data-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>
<!-- Modal -->
<div class="modal fade" id="documents" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title lol" id="exampleModalLabel">Attachmements</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group row">
                    <table id="tblStandar" class="table table-striped table-bordered" style="width:100%;">
                        <thead>
                            <tr>
                                <th>Documents name</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="$('#tblQm').modal('hide');" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal -->
<div class="modal fade bd-example-modal-lg" id="Comment" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group row">
                    <div class="menu_nosotros">
                        <nav>
                            <a href="#D1">Description of requested change</a>
                            <a href="#D2">Benefits as a Result of the Changes</a>
                            <a href="#D3">Actual changes to be made</a>
                        </nav>
                    </div>
                </div>
                <div id="D3" class="ocultar">
                </div>
                <div id="D2" class="ocultar">
                </div>
                <div id="D1" class="ocultar">
                </div>
