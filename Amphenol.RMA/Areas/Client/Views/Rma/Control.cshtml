            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="$('#tblQm').modal('hide');" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal -->
<div id="lineas" class="modal fade bd-example-modal-lg my-controller" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title lol" id="exampleModalLabel">Lines</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                </button>
            </div>
            <div class="modal-body">
                <table id="tbllineas" class="table table-striped table-bordered table-hover responsive" style="width:100%;">
                    <thead>
                        <tr>
                            <th>Invoice Num.</th>
                            <th>Seq No.</th>
                            <th>Part Number</th>
                            <th>Authorized Qty</th>
                            <th>Price</th>
                            <th>Unit Cost</th>
                            <th>Action</th>
                            <th>Return</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="$('#tblQm').modal('hide');" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal -->
<div class="modal fade" id="documents" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title lol" id="exampleModalLabel">Attachments</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                </button>
            </div>
            <div class="modal-body">

                <div class="form-group row">


                    <table id="tblStandar" class="table table-striped table-bordered" style="width:100%;">
                        <thead>
                            <tr>

                                <th>Documen name</th>
                                <th></th>

                            </tr>
                        </thead>

                        <tbody>
                        </tbody>


                    </table>
                </div>


            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="$('#tblQm').modal('hide');" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal -->
<div class="modal fade bd-example-modal-lg" id="Aprobar" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <form id="frmaprobar" method="post" asp-action="Aprobar">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">RMA Request</h5>

                    <div class="d-flex">
                        <button type="button" class="btn btn-secondary" onclick="$('#tblQm').modal('hide');" data-dismiss="modal">Close</button>
                    </div>
                </div>
                <div class="modal-body">

                    <div class="form-group row m-1">
                        <label for="commentt">Comments</label>
                        <textarea name="commentt" id="commentt" class="form-control" rows="7"></textarea>
                        <input type="hidden" name="idsa" id="idsa" />
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="submit" id="botonaprobar" class="btn btn-success float-right mr-1">
                        Approve Request
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>
<!-- Modal -->
<div class="modal fade bd-example-modal-lg" id="Rechazar" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <form id="frmrechazo" method="post" asp-action="Desaprobar">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">RMA Request</h5>
                    <div class="d-flex">
                        <button type="button" class="btn btn-secondary" onclick="$('#tblQm').modal('hide');" data-dismiss="modal">Close</button>
                    </div>
                </div>
                <div class="modal-body">

                    <div class="form-group row m-1">
                        <label for="commentt">Comments</label>
                        <textarea name="comment" id="comment" class="form-control" rows="7">     </textarea>
                        <input type="hidden" name="ids" id="ids" />
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="submit" id="botonrechazo" class="btn btn-danger mr-1">
                        Reject Request
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>
<!-- Modal -->
<div class="modal fade bd-example-modal-lg" id="RemarkModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <form method="post" asp-action="Remark">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Remark Comments</h5>
                    <div class="d-flex">
                        <button type="button" class="btn btn-secondary" onclick="$('#tblQm').modal('hide');" data-dismiss="modal">Close</button>
                    </div>
                    @*<button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>*@
                </div>
                <div class="modal-body">
                    <div class="form-group row">
                        <div>
                            <textarea name="commentrema" id="commentrema" class="form-control" rows="7">     </textarea>
                            <input type="hidden" name="idrema" id="idrema" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary mr-1">
                        Save
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>
<!--customarcomplain-->
<div class="modal fade bd-example-modal-lg" id="Customer_complaint" tabindex="-1" aria-labelledby="customerComplaintTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg">
