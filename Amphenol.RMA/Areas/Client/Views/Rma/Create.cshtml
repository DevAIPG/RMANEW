@model Amphenol.RMA.ViewModels.RmaModalViewModel
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout6.cshtml";
}
<link href="~/css/jquery.loadingModal.min.css" rel="stylesheet" />
<div class="card">
    <div class="card-header">

    </div>
    <div class="card-body">
        <div class="row">
            <!-- Request Information -->
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-4">Request #:</dt>
                        <dd class="col-8">@Model.Data.Details.Rmarequest</dd>

                        <dt class="col-4">Build Location:</dt>
                        <dd class="col-8">
                            <select asp-for="Data.Details.Wherebuilt" id="selectWherebuilt" class="form-control form-control-sm">
                                <option value="Nogales">Nogales</option>
                                <option value="Endicott">Endicott</option>
                                <option value="Mesa">Mesa</option>
                            </select>
                        </dd>
                        <dt class="col-4">Request Type:</dt>
                        <dd class="col-8">
                            <select asp-for="Data.Details.Rmatypeofrequest" id="selectRequestType" class="form-control form-control-sm">
                                <option value="VALUE ADD RMA">VALUE ADD RMA</option>
                                <option value="CREDIT ONLY">CREDIT ONLY</option>
                                <option value="DISTY SCRAP ALLOWANCE">DISTY SCRAP ALLOWANCE</option>
                            </select>
                        </dd>
                    </dl>
                </div>

                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-4">Date:</dt>
                        <dd class="col-8">@Model.Data.Details.Date</dd>

                        <dt class="col-4">Total Value:</dt>
                        <dd class="col-8">
                            $@Model.Data.Details.Totalrmavalues.ToString("F4")
                        </dd>

                        <dt class="col-4">Reason:</dt>
                        <dd class="col-8">
                            <select asp-for="Data.Details.reason" id="selectReason" class="form-control form-control-sm">
                                <option value="1" selected="@(Model.Data.Details.reason == "Billing Error")">Billing Error</option>
                                <option value="2" selected="@(Model.Data.Details.reason == "Buyback")">Buyback</option>
                                <option value="3" selected="@(Model.Data.Details.reason == "Price Adjustment")">Price Adjustment</option>
                                <option value="4" selected="@(Model.Data.Details.reason == "Price Protection")">Price Protection</option>
                                <option value="5" selected="@(Model.Data.Details.reason.Trim() == "Quality Issues - NG")">Quality Issues - NG</option>
                                <option value="6" selected="@(Model.Data.Details.reason == "Quality Issues - END")">Quality Issues - END</option>
                                <option value="7" selected="@(Model.Data.Details.reason.Trim() == "Shipping Error")">Shipping Error</option>
                                <option value="8" selected="@(Model.Data.Details.reason == "Contractual Return/Stock")">Contractual Return/Stock</option>
                                <option value="9" selected="@(Model.Data.Details.reason == "Ship and Debits")">Ship and Debits</option>
                                <option value="10" selected="@(Model.Data.Details.reason == "Scrap Allowance")">Scrap Allowance</option>
                                <option value="11" selected="@(Model.Data.Details.reason == "Marcomco-op")">Marcomco-op</option>
                            </select>
                        </dd>
                    </dl>
                </div>
                <div class="col-12 mb-4">
                    <div class="fw-bold mb-1">Description</div>
                    <input class="form-control" asp-for="Data.Details.Description" id="inputDescription" maxlength="29" />
                </div>
                <hr />
            </div>
            <div class="row">
                <!-- Customer Information -->
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-4">Customer:</dt>
                        <dd class="col-8">
                            <div class="input-group">
                                <input class="form-control" asp-for="Data.Details.Customer" id="inputCustomer" required list="customerOptions" autocomplete="off" />
                                <datalist id="customerOptions">
                                </datalist>
                                <span class="btn btn-sm btn-outline-secondary" onclick="OpenCustomerModal()"><i class="fa fa-search"></i></span>
                                <div class="invalid-feedback">
                                    Please provide a customer number.
                                </div>
                            </div>
                        </dd>
                        <dt class="col-4">Ship To:</dt>
                        <dd class="col-8">
                            <div class="input-group">
                                <input class="form-control" disabled asp-for="Data.Details.Ship_To" id="inputShipTo" />
                                <span class="btn btn-sm btn-outline-secondary" onclick="OpenShipToModal()"><i class="fa fa-search"></i></span>
                            </div>
                        </dd>


                        <dt class="col-4 contact-info">Phone:</dt>
                        <dd class="col-8 contact-info">
                            <div class="row">
                                <div class="col-7">
                                    <input class="form-control" asp-for="Data.Details.Phone" id="inputPhone" />
                                </div>
                                <div class="col-2 text-end">
                                    <label for="inputExtension" class="col-form-label"><strong>Ext:</strong></label>
                                </div>
                                <div class="col-3">
                                    <input class="form-control" asp-for="Data.Details.Ext" id="inputExtension" />
                                </div>
                            </div>
                        </dd>

                        <dt class="col-4 contact-info">Email:</dt>
                        <dd class="col-8 contact-info">
                            <input class="form-control" asp-for="Data.Details.Email" id="inputContactEmail" />
                        </dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-4">Cust. PO #:</dt>
                        <dd class="col-8">
                            <input class="form-control" asp-for="Data.Details.Customerpo" id="inputCustomerPo" />
                        </dd>
                        <dt class="col-4  contact-info">Contact:</dt>
                        <dd class="col-8  contact-info">
                            <input class="form-control" asp-for="Data.Details.Contact" id="inputContact" />
                        </dd>

                        <dt class="col-4 contact-info">Fax:</dt>
                        <dd class="col-8 contact-info">
                            <input class="form-control" asp-for="Data.Details.Fax" id="inputFax" />
                        </dd>
                        <dt class="col-4 contact-info">Co. Email:</dt>
                        <dd class="col-8 contact-info">
                            <input class="form-control" asp-for="Data.Details.Company" id="inputCompanyEmail" />
                        </dd>
                    </dl>
                </div>
                <div class="col-12 mb-4">
                    <div class="fw-bold mb-1">Complaint</div>
                    <textarea class="form-control" asp-for="Data.Details.Customercomplait" id="textareaComplaint"></textarea>
                </div>
                <hr />
            </div>
            <!-- Line Information -->
            <div class="row">
                <div class="col-6">
                    <dl class="row">
                        <dt class="col-4">Lines</dt>
                    </dl>
                </div>
                <div class="col-6">
                    <span class="btn btn-sm btn-primary action-btn float-right btn-add-rma-line"><i class="fa fa-plus"></i></span>
                </div>
                <div class="col-12 mb-3">
                    <div class="table-responsive">
                        <table id="LineTable" class="table table-striped table-bordered text-center align-middle" style="table-layout:fixed;">
                            <thead class="table-light">
                                <tr>
                                    <th width="35px"></th>
                                    <th width="150px">Invoice #</th>
                                    <th width="90px">Sequence</th>
                                    <th width="150px">Part Number</th>
                                    <th width="80px">Action</th>
                                    <th width="150px">Location</th>
                                    <th width="150px">Authorized Qty</th>
                                    <th width="150px">Price</th>
                                    <th width="150px">Unit Cost</th>
                                    <th width="150px">Return Code</th>
                                    <th width="120px">Create CAR</th>
                                </tr>
                            </thead>
                            <tbody>

                                @for (int i = 0; i < Model.Data.ItemLines.Count; i++)
                                {
                                    @await Html.PartialAsync("RmaItemEditableLine", Model.Data.ItemLines[i], new ViewDataDictionary(ViewData) { ["Index"] = i })
                                }
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
            <!-- Attachment Information -->
            <div class="row">
                <div class="col-6">
                    <dl class="row">
                        <dt class="col-4">Attachments</dt>
                    </dl>
                </div>
                <div class="col-6">
                    <span class="btn btn-sm btn-primary action-btn float-right"><i class="fa fa-plus"></i></span>
                </div>
                <div class="col-12">
                    @if (Model.Data.Attachments.Any())
                    {
                        <div class="table-responsive">
                            <table id="GeneratedRmaTable" class="table table-striped table-bordered text-center align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th class="d-none">ID</th>
                                        <th></th>
                                        <th>Filename</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var file in Model.Data.Attachments)
                                    {
                                        <tr>
                                            <td class="d-none">@file.Id</td>
                                            <td>
                                                <span class="btn btn-sm btn-outline-danger" title="Remove Attachment"><i class="fa fa-trash"></i></span>
                                            </td>
                                            <td>@file.Documento</td>
                                            <td>
                                                <span class="btn btn-light btn-sm action-btn"
                                                      data-bs-toggle="tooltip"
                                                      title="View File">
                                                    <i class="fa fa-eye"></i>
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light">
                            No attachments available.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
