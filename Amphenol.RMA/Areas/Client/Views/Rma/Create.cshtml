@model Amphenol.RMA.ViewModels.RmaViewModel
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout6.cshtml";
}
<link href="~/css/jquery.loadingModal.min.css" rel="stylesheet" />
<div asp-validation-summary="All" class="alert alert-danger"></div>
<div class="card">
    <form method="post" enctype="multipart/form-data">
        <div class="card-header">
            <div class="row p-3">
                <div class="col-12">
                    <h5 class="font-weight-bold">New RMA Request</h5>
                </div>
            </div>
        </div>
        <div class="card-body">
            <!-- Request Information -->
            <div class="row p-3">
                <div class="col-12 mb-3">
                    <h5 class="font-weight-bold">RMA Information</h5>
                </div>
                <div class="col-6">
                    <div class="mb-2 row">
                        <label class="col-3 col-form-label font-weight-bold">Request #:</label>
                        <label class="col-9 form-control disabled" style="background-color:#e9ecef">@Model.RequestId</label>
                        @Html.HiddenFor(x => x.RequestId)
                    </div>
                    <div class="mb-2 row">
                        <label class="col-3 col-form-label font-weight-bold">Build Location:</label>
                        <select class="col-9 form-select form-control" asp-for="SelectedBuildLocation" id="selectWherebuilt"
                                asp-items="@(new SelectList(Model.BuildLocations))">
                        </select>
                    </div>
                    <div class="mb-2 row">
                        <label class="col-3 col-form-label font-weight-bold">Request Type:</label>
                        <select class="col-9 form-select form-control" asp-for="SelectedRequestType" id="selectRequestType"
                                asp-items="@(new SelectList(Model.RequestTypes))">
                        </select>
                    </div>
                    <div class="mb-2 row">
                        <div class="col-3 col-form-label font-weight-bold">Description:</div>
                        <input class="col-9  form-control" asp-for="Description" id="inputDescription" maxlength="29" />
                    </div>
                </div>
                <div class="col-6">
                    <div class="mb-2 row">
                        <label class="col-3 col-form-label font-weight-bold">Date:</label>
                        <label class="col-9 form-control disabled" style="background-color:#e9ecef">@Model.Date.ToString("MM/dd/yyyy")</label>
                    </div>
                    <div class="mb-2 row">
                        <label class="col-3 col-form-label font-weight-bold">Total Value:</label>
                        <label class="col-9 form-control totalrmavalue-label disabled" style="background-color:#e9ecef">@Model.TotalValue</label>
                    </div>
                    <div class="mb-2 row">
                        <label class="col-3 col-form-label font-weight-bold">Reason:</label>
                        <select class="col-9 form-select form-control" asp-for="SelectedReason" id="selectReason"
                                asp-items="@(new SelectList(Model.Reasons, nameof(SelectableStringOption.SelectedValue), nameof(SelectableStringOption.DisplayValue)))">
                        </select>
                    </div>
                </div>
                <div class="col-12">
                    <hr>
                </div>
            </div>
            <!-- Customer Information -->
            <div class="row p-3">
                <div class="col-12 mb-3">
                    <h5 class="font-weight-bold">Customer Information</h5>
                </div>
                <div class="col-6">
                    <div class="mb-2 row">
                        <label class="col-3 col-form-label font-weight-bold" for="inputCustomer">Customer:</label>
                        <div class="col-9 input-group">
                            <input class="form-control" placeholder="Enter or search for a customer id" asp-for="CustomerId" id="inputCustomer" required list="customerOptions" autocomplete="off" />
                            <span class="btn btn-sm btn-outline-secondary" data-toggle="modal" data-target="#CustomerModal"><i class="fa fa-search"></i></span>
                        </div>
                        <datalist id="customerOptions">
                        </datalist>
                        <div class="invalid-feedback">
                            Please provide a customer number.
                        </div>
                    </div>
                    <div class="mb-2 row customer-info d-none">
                        <label class="col-3 col-form-label font-weight-bold">Contact:</label>
                        <div class="col-9 input-group">
                            <input class="form-control" asp-for="Contact" id="inputContact" />
                            <span asp-validation-for="Contact" class="col-12 text-danger"></span>
                        </div>

                    </div>
                    <div class="mb-2 row customer-info d-none">
                        <label class="col-3 col-form-label font-weight-bold">
                            Phone:
                        </label>
                        <div class="col-9">
                            <div class="row">
                                <div class="col-6">
                                    <input class="form-control" asp-for="PhoneNumber" id="inputPhone" />
                                </div>
                                <label class="col-2 col-form-label font-weight-bold">
                                    Ext:
                                </label>
                                <div class="col-4">
                                    <input class="form-control" asp-for="ExtensionNumber" id="inputExtension" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="col-12 text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="mb-2 row customer-info d-none">
                        <label class="col-3 col-form-label font-weight-bold">Email:</label>
                        <div class="col-9 input-group">
                            <input class="form-control" asp-for="ContactEmail" id="inputContactEmail" />
                            <span asp-validation-for="ContactEmail" class="col-12 text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-2 row customer-info d-none">
                        <label class="col-3 col-form-label font-weight-bold">Complaint:</label>
                        <div class="col-9 input-group">
                            <textarea class="form-control" asp-for="Complaint" id="textareaComplaint"></textarea>
                            <span asp-validation-for="Complaint" class="col-12 text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="mb-2 row shipto-section d-none">
                        <label class="col-3 col-form-label font-weight-bold">Ship To:</label>
                        <div class="col-9 input-group">
                            <input class="form-control disabled" readonly asp-for="ShipTo" id="inputShipTo" required autocomplete="off" />
                            <span class="btn btn-sm btn-outline-secondary" onclick="OpenShipToModal()"><i class="fa fa-search"></i></span>
                            <span asp-validation-for="ShipTo" class="col-12 text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-2 row customer-info d-none">
                        <label class="col-3 col-form-label font-weight-bold">Cust. PO #:</label>
                        <div class="col-9 input-group">
                            <input class="form-control" asp-for="PoNumber" id="inputCustomerPo" />
                            <span asp-validation-for="PoNumber" class="col-12 text-danger"></span>
                        </div>

                    </div>
                    <div class="mb-2 row customer-info d-none">
                        <label class="col-3 col-form-label font-weight-bold">Fax:</label>
                        <div class="col-9 input-group">
                            <input class="form-control" asp-for="Fax" id="inputFax" />
                        </div>
                    </div>
                    <div class="mb-2 row customer-info d-none">
                        <label class="col-3 col-form-label font-weight-bold">Company Email:</label>
                        <div class="col-9 input-group">
                            <input class="form-control disabled" readonly asp-for="CompanyEmail" id="inputCompanyEmail" />
                        </div>
                    </div>
                </div>
                <div class="col-12 mt-3 mb-3">
                    <hr>
                </div>
            </div>
            <!-- Line Information -->
            <div class="row line-section p-3 d-none">
                <div class="col-12 mb-3">
                    <h5 class="font-weight-bold mr-3">Lines</h5>
                    <span class="btn btn-sm btn-primary action-btn float-right btn-add-rma-line"><i class="fa fa-plus"></i></span>
                </div>
                <div class="col-12">
                    <div class="table-responsive">
                        <table id="LineTable" class="table table-striped table-bordered text-center align-middle" style="table-layout:fixed;">
                            <colgroup>
                                <col style="width:50px">
                                <col style="width:150px">
                                <col style="width:100px">
                                <col style="width:260px">
                                <col style="width:260px">
                                <col style="width:215px">
                                <col style="width:150px">
                                <col style="width:150px">
                                <col style="width:150px">
                                <col style="width:150px">
                                <col style="width:120px">
                            </colgroup>
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Invoice #</th>
                                    <th>Sequence</th>
                                    <th>Part Number</th>
                                    <th>Action</th>
                                    <th>Location</th>
                                    <th>Authorized Qty</th>
                                    <th>Price</th>
                                    <th>Unit Cost</th>
                                    <th>Return Code</th>
                                    <th>Create CAR</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Lines != null && Model.Lines.Any())
                                {
                                    @for (int i = 0; i < Model.Lines.Count; i++)
                                    {
                                        @await Html.PartialAsync("RmaItemEditableLine", Model.Lines[i], new ViewDataDictionary(ViewData) { ["Index"] = i })
                                    }
                                }
                                else
                                {
                                    <tr id="emptyLineRow">
                                        <td colspan="11" class="text-center text-muted py-4">
                                            <div class="d-flex justify-content-center align-items-center">
                                                <h5 class="font-weight-bold mb-0 mr-3">Add new lines</h5>
                                                <button type="button" class="btn btn-sm btn-primary action-btn btn-add-rma-line">
                                                    <i class="fa fa-plus"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-12 mt-3 mb-3">
                    <hr>
                </div>
            </div>
            <!-- Attachment Information -->
            <div class="row attachment-section p-3 d-none">
                <div class="col-12 mb-3">
                    <h5 class="font-weight-bold">Attachments</h5>
                    <span class="btn btn-sm btn-primary action-btn float-right btn-add-rma-attachment"><i class="fa fa-plus"></i></span>
                </div>
                <div class="col-12">
                    <input type="file" id="attachmentInput" name="UploadedFiles" multiple hidden />
                    <div class="table-responsive">
                        <table id="AttachmentTable" class="table table-striped table-bordered text-center align-middle" style="table-layout:fixed;">
                            <colgroup>
                                <col style="width:50px">
                                <col>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Filename</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Attatchments != null && Model.Attatchments.Any())
                                {
                                    @for (int i = 0; i < Model.Attatchments.Count; i++)
                                    {
                                        @await Html.PartialAsync("RmaAttachmentRow", Model.Attatchments[i], new ViewDataDictionary(ViewData) { ["Index"] = i })
                                    }
                                }
                                else
                                {
                                    <tr id="emptyAttachmentRow">
                                        <td colspan="2" class="text-center text-muted py-4">
                                            <div class="d-flex justify-content-center align-items-center">
                                                <h5 class="font-weight-bold mb-0 mr-3">Add attachments</h5>
                                                <button type="button" class="btn btn-sm btn-primary action-btn btn-add-rma-attachment">
                                                    <i class="fa fa-plus"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer text-right">
            <button type="button" class="btn btn-secondary mr-5">
                Cancel
            </button>

            <button type="button" class="btn btn-outline-primary mr-3">
                Save & Exit
            </button>

            <button type="submit" class="btn btn-primary">
                Submit RMA
            </button>
        </div>
    </form>
</div>



