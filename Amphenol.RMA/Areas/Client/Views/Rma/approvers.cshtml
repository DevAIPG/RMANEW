@model Amphenol.RMA.Models.CSEXSW_Rma
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout6.cshtml";
}

<div class="container my-5">
    <h1 class="display-5 fw-bold text-center mb-5 animate__animated animate__fadeIn">RMA Approval Levels</h1>

    <div class="row g-4">
        <!-- Quality Manager -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow border-0 h-100 animate__animated animate__fadeInUp rounded-3">
                <div class="card-body">
                    <form method="post" asp-action="Editapprovers" enctype="multipart/form-data" autocomplete="off" class="needs-validation" novalidate>
                        <input type="hidden" id="proceso" value="approvers" />
                        <input type="hidden" asp-for="Id" value="1" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-primary">Quality Manager</label>
                            <select asp-for="Approver" asp-items="ViewBag.QM" class="form-select rounded-1 p-2" required>
                                <option value="">--Select--</option>
                            </select>
                            <div class="invalid-feedback">Please select a Quality Manager.</div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <label class="form-label text-muted">Email: @ViewBag.mail1</label>
                            <button type="submit" class="btn btn-primary btn-sm rounded-2" data-bs-toggle="tooltip" title="Save Changes">
                                <i class="bi bi-save me-1"></i> Save
                                <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Quality Director -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow border-0 h-100 animate__animated animate__fadeInUp rounded-3" style="animation-delay: 0.1s;">
                <div class="card-body">
                    <form method="post" asp-action="Editapprovers" enctype="multipart/form-data" class="needs-validation" novalidate>
                        <input type="hidden" asp-for="Id" value="2" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-primary">Quality Director</label>
                            <select asp-for="Approver" asp-items="ViewBag.QD" class="form-select rounded-1 p-2" required>
                                <option value="">--Select--</option>
                            </select>
                            <div class="invalid-feedback">Please select a Quality Director.</div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <label class="form-label text-muted">Email: @ViewBag.mail2</label>
                            <button type="submit" class="btn btn-primary btn-sm rounded-2" data-bs-toggle="tooltip" title="Save Changes">
                                <i class="bi bi-save me-1"></i> Save
                                <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Global Marketing Director -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow border-0 h-100 animate__animated animate__fadeInUp rounded-3" style="animation-delay: 0.2s;">
                <div class="card-body">
                    <form method="post" asp-action="Editapprovers" enctype="multipart/form-data" class="needs-validation" novalidate>
                        <input type="hidden" asp-for="Id" value="3" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-primary">Global Marketing Director</label>
                            <select asp-for="Approver" asp-items="ViewBag.GM" class="form-select rounded-1 p-2" required>
                                <option value="">--Select--</option>
                            </select>
                            <div class="invalid-feedback">Please select a Global Marketing Director.</div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <label class="form-label text-muted">Email: @ViewBag.mail3</label>
                            <button type="submit" class="btn btn-primary btn-sm rounded-2" data-bs-toggle="tooltip" title="Save Changes">
                                <i class="bi bi-save me-1"></i> Save
