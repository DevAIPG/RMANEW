                </div>
            </div>
        </div>

        <!-- Dee -->
        <div class="mt-3 col-md-6 col-lg-4">
            <div class="card shadow border-0 h-100 animate__animated animate__fadeInUp rounded-3" style="animation-delay: 0.3s;">
                <div class="card-body">
                    <form method="post" asp-action="Editapprovers" enctype="multipart/form-data" class="needs-validation" novalidate>
                        <input type="hidden" asp-for="Id" value="4" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-primary">Dee</label>
                            <select asp-for="Approver" asp-items="ViewBag.Dee" class="form-select rounded-1 p-2" required>
