@model Amphenol.RMA.Models.ErrorViewModel
@{
    Layout = "~/Views/Shared/_Layout6.cshtml";
    ViewData["Title"] = "Request error";
}

<h1>Unable to complete the request</h1>
<p>@ViewData["ErrorMessage"]</p>
<p>Error reference: <code>@Model.RequestId</code></p>
<a class="btn btn-primary" href="@Url.Action("Index", "Rma", new { area = "Client" })">Return to RMA requests</a>
<div hidden data-global-error-message="@ViewData["ErrorMessage"]" data-global-error-reference="@Model.RequestId"></div>
