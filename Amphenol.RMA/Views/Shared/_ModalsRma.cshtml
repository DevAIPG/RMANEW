                            <dir-pagination-controls boundary-links="true" on-page-change="pageChangeHandler5(newPageNumber)"></dir-pagination-controls>
                        </div>
                        <small>Items : {{count5}}</small>
                    </div>
                </div>


            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="$('#tblQm').modal('hide');" data-dismiss="modal">Close</button>

            </div>
        </div>
    </div>
</div>


