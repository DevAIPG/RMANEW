@model Amphenol.RMA.Models.ViewModels.csexsw_coustumerVM

<!--Modal Reason Code-->
<div class="modal fade" id="tblSm2" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title lol" id="exampleModalLabel">Reason Code</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group row">
                    <table id="tblS2" class="table table-striped table-bordered" style="width:100%;">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="$('#tblQm').modal('hide');" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<div id="tblIm2" class="modal fade bd-example-modal-lg my-controller" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title lol" id="exampleModalLabel">
                    Invoice History Price
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                </button>
            </div>
            <div class="modal-body table-responsive">


                <div class="row justify-content-between">

                    <div class="col-xs-6">
                        <label for="search">Search:</label>
                        <input ng-model="searchorders" id="search" class="form-control" placeholder="Filter text" ng-keyup="moverA(1)">
                    </div>

                </div>
                <br>

                <table id="invoice2" class="table table-striped table-bordered table-hover responsive" style="width:100%;">
                    <thead>
                        <tr>
                            <th>Invoice No</th>


                            <th> Customer</th>
                            <th>Date</th>
                            <th>Seq No</th>
                            <th>Item No</th>
                            <th>Description</th>
                            <th>Price</th>
                            <th>Cost</th>

                            <th>Quantity Ordered</th>
                            <th>Quantity Shipped</th>

                        </tr>
                    </thead>
                    <tbody>
                        <tr dir-paginate="x in orderhistory.orders | itemsPerPage: 10 " total-items="orderhistory.total_paginas">
                            <td><a data-dismiss='modal' ng-click="Mover9(x)">{{x.inv}}</a></td>
                            <td>{{x.cus_no}}</td>
                            <td>{{x.date | fecha}}</td>
                            <td>{{x.seq}}</td>
                            <td>{{x.item_no}}</td>
                            <td>{{x.description}}</td>
                            <td>{{x.price}}</td>
                            <td>{{x.cost}}</td>
                            <td>{{x.ordered}}</td>
                            <td>{{x.qty_to_ship}}</td>
                        </tr>
                    </tbody>


                </table>

                <div class="other-controller">




                    <div class="other-controller">





                        <dir-pagination-controls boundary-links="true" max-size="15" on-page-change="moverA(newPageNumber)"></dir-pagination-controls>



                    </div>





                    <small>Items : {{orderhistory.conteo}}</small>

                </div>



            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="$('#tblQm').modal('hide');" data-dismiss="modal">Close</button>

            </div>
        </div>
    </div>
</div>

<!--MODAL PART NUMBER-->
