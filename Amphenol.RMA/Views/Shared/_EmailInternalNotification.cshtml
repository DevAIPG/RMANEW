                                                                                    <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word"  href="http://example.com"  style="height:52px;width:166px;v-text-anchor:middle;" arcsize="8%" fillcolor="#005cb9">
                                                                                    <v:stroke dashstyle="Solid" weight="0px" color="#005cb9"/>
                                                                                    <w:anchorlock/>
                                                                                    <v:textbox inset="0px,0px,0px,0px">
                                                                                    <center dir="false" style="color:#ffffff;font-family:sans-serif;font-size:16px">
                                                                                    <![endif]-->
                                                                                    <span class="button" style="background-color: #005CB9; border-bottom: 0px solid transparent; border-left: 0px solid transparent; border-radius: 4px; border-right: 0px solid transparent; border-top: 0px solid transparent; color: #ffffff; display: inline-block; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 16px; font-weight: undefined; mso-border-alt: none; text-align: center; width: auto; word-break: keep-all; letter-spacing: normal;"><span class="btn-pad" style="word-break: break-word; padding-left: 15px; padding-right: 15px; padding-top: 10px; padding-bottom: 10px; display: block;"><span style="word-break: break-word; line-height: 32px;">@Model.ActionText</span></span></span><!--[if mso]></center></v:textbox></v:roundrect><![endif]-->
                                                                                </a>
                                                                            </td>
                                                                        </tr>
                                                                    </table>
