                                                                            <div style="max-width: 240px;"><img src="https://amphenol-industrial.com/wp-content/uploads/2023/08/Logo.png" style="display: block; height: auto; border: 0; width: 100%;" width="240" alt="Amphenol Industrial Operations" title="Amphenol Industrial Operations" height="auto"></div>
                                                                        </td>
                                                                    </tr>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </tbody>
                    </table>
