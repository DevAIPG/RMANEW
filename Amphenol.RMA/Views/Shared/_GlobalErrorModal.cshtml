<dialog id="globalErrorModal" aria-labelledby="globalErrorTitle" aria-describedby="globalErrorMessage">
    <h2 id="globalErrorTitle">Unable to complete the request</h2>
    <p id="globalErrorMessage"></p>
    <p id="globalErrorReferenceRow" hidden>Error reference: <code id="globalErrorReference"></code></p>
    <form method="dialog">
        <button class="btn btn-primary" type="submit" autofocus>Close</button>
    </form>
</dialog>
